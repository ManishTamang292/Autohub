{% extends "base.html.twig" %}

{% block title %}AutoHub - Edit Car{% endblock %}

{% block content %}

<h2>Edit Car</h2>

<form method="POST">

    <label>Make:</label>
    <input type="text" name="make" value="{{ car.make }}" required>

    <br><br>

    <label>Model:</label>
    <input type="text" name="model" value="{{ car.model }}" required>

    <br><br>

    <label>Year:</label>
    <input type="number" name="year" value="{{ car.year }}" required>

    <br><br>

    <label>Price:</label>
    <input type="number" step="0.01" name="price" value="{{ car.price }}" required>

    <br><br>

    <label>Mileage:</label>
    <input type="number" name="mileage" value="{{ car.mileage }}" required>

    <br><br>

    <label>Fuel type:</label>
    <select name="fuel_type" required>
        <option value="Petrol" {% if car.fuel_type == 'Petrol' %}selected{% endif %}>Petrol</option>
        <option value="Diesel" {% if car.fuel_type == 'Diesel' %}selected{% endif %}>Diesel</option>
        <option value="Hybrid" {% if car.fuel_type == 'Hybrid' %}selected{% endif %}>Hybrid</option>
        <option value="Electric" {% if car.fuel_type == 'Electric' %}selected{% endif %}>Electric</option>
    </select>

    <br><br>

    <label>Transmission:</label>
    <select name="transmission" required>
        <option value="Manual" {% if car.transmission == 'Manual' %}selected{% endif %}>Manual</option>
        <option value="Automatic" {% if car.transmission == 'Automatic' %}selected{% endif %}>Automatic</option>
    </select>

    <br><br>

    <label>Body type:</label>
    <select name="body_type" required>
        <option value="Hatchback" {% if car.body_type == 'Hatchback' %}selected{% endif %}>Hatchback</option>
        <option value="Saloon" {% if car.body_type == 'Saloon' %}selected{% endif %}>Saloon</option>
        <option value="SUV" {% if car.body_type == 'SUV' %}selected{% endif %}>SUV</option>
        <option value="Estate" {% if car.body_type == 'Estate' %}selected{% endif %}>Estate</option>
        <option value="Coupe" {% if car.body_type == 'Coupe' %}selected{% endif %}>Coupe</option>
        <option value="Convertible" {% if car.body_type == 'Convertible' %}selected{% endif %}>Convertible</option>
    </select>

    <br><br>

    <label>Colour:</label>
    <input type="text" name="colour" value="{{ car.colour }}" required>

    <br><br>

    <label>Location:</label>
    <input type="text" name="location" value="{{ car.location }}" required>

    <br><br>

    <label>Description:</label>
    <br>
    <textarea name="description" rows="5" cols="40" required>{{ car.description }}</textarea>

    <br><br>

    <button type="submit">Update Car</button>

</form>

<br>

<a href="car-details.php?id={{ car.car_id }}">Cancel</a>

{% endblock %}