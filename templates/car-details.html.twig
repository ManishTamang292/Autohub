{% extends "base.html.twig" %}

{% block title %}AutoHub - {{ car.make }} {{ car.model }}{% endblock %}

{% block content %}

<div class="container py-5">

    <div class="car-detail-page">

        <a href="cars.php" class="car-detail-back">
            ← Back to Cars
        </a>


        <div class="car-detail-hero">

            <div class="car-detail-image">

                {% if car.image %}

                    <img
                        src="images/cars/{{ car.image }}"
                        alt="{{ car.make }} {{ car.model }}"
                    >

                {% else %}

                    <div class="car-detail-image-placeholder">
                        No Image Available
                    </div>

                {% endif %}

            </div>


            <div class="car-detail-summary">

                <span class="car-detail-label">
                    {{ car.year }} • {{ car.body_type }}
                </span>

                <h1>
                    {{ car.make }} {{ car.model }}
                </h1>

                <div class="car-detail-price">
                    £{{ car.price|number_format(0, '.', ',') }}
                </div>

                <p class="car-detail-location">
                    {{ car.location }}
                </p>


                <div class="car-detail-divider"></div>


                <div class="car-detail-specs">

                    <div class="car-detail-spec">
                        <small>Mileage</small>
                        <strong>{{ car.mileage }} miles</strong>
                    </div>

                    <div class="car-detail-spec">
                        <small>Fuel</small>
                        <strong>{{ car.fuel_type }}</strong>
                    </div>

                    <div class="car-detail-spec">
                        <small>Transmission</small>
                        <strong>{{ car.transmission }}</strong>
                    </div>

                    <div class="car-detail-spec">
                        <small>Colour</small>
                        <strong>{{ car.colour }}</strong>
                    </div>

                </div>


                <div class="car-detail-actions">

                    <a
                        href="edit-car.php?id={{ car.car_id }}"
                        class="btn btn-warning"
                    >
                        Edit Car
                    </a>

                    <form
                        method="POST"
                        action="delete-car.php"
                        data-confirm="Are you sure you want to delete this car?"
                    >

                        <input
                            type="hidden"
                            name="id"
                            value="{{ car.car_id }}"
                        >

                        <input
                            type="hidden"
                            name="csrf_token"
                            value="{{ csrf_token }}"
                        >

                        <button
                            type="submit"
                            class="btn btn-danger"
                        >
                            Delete Car
                        </button>

                    </form>

                </div>

            </div>

        </div>


        <div class="car-detail-description">

            <span class="section-label">
                VEHICLE DESCRIPTION
            </span>

            <h2>
                About This <span>Vehicle.</span>
            </h2>

            <div class="car-description-text">
                {{ car.description|nl2br }}
            </div>

        </div>

    </div>

</div>

{% endblock %}